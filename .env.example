# Copy this file to .env and fill in your values. .env is never committed.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: another model name
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: if Python says CERTIFICATE_VERIFY_FAILED behind Zscaler, export your company's
# root certificate (ask IT, or export "Zscaler Root CA" from your browser) and point to it:
# GEMINI_CA_BUNDLE=C:\certs\zscaler_root.pem

# Optional: run without Gemini (agents use built-in rules)
# LLM_MODE=offline

# Optional: post notifications to a Teams channel
# TEAMS_WEBHOOK_URL=
